{
  "name": "@stage5/browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reliability-first local browser control for AI agents.",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "stage5-browser": "./dist/mcp-server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers tsx src/mcp-server.ts",
    "start": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers node dist/mcp-server.js",
    "test": "npm run build && PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers vitest run",
    "test:watch": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers vitest",
    "check": "npm run test",
    "browser:install": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright install chromium firefox webkit",
    "smoke": "npm run build && PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers node dist/smoke.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "playwright": "1.62.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "26.2.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
